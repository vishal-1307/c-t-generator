# ---------------------------------------------------------------- environment
# development | production
#
# `development` (the default) keeps a fresh checkout working with no setup:
# a random JWT key, localhost CORS, and a well-known first-run admin account.
#
# `production` REFUSES TO START until each of those is replaced, and prints the
# complete list of what is missing. See OPERATIONS.md.
APP_ENV=development

# ----------------------------------------------------------------- database
# SQLite is fine for local development. Production requires PostgreSQL -
# SQLite has no concurrent-writer story and would block or corrupt under two
# API workers.
DATABASE_URL=sqlite:///./timetable.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/timetable

# --------------------------------------------------------------------- auth
# Signs login tokens. Required in production; unset in development means a
# random key per process, so every session is invalidated on restart.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=

# The first admin account, created only when the user table is empty.
# In production BOTH must be set or no account is created at all - a
# well-known password is never reachable on a deployed system.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------- web
# Exact origins of the front end, comma-separated. A browser treats
# localhost:3000 and 127.0.0.1:3000 as different origins, so both are listed
# by default. Must be changed for production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------ uploads
# Ceiling for every uploaded file (10 MB).
# MAX_UPLOAD_BYTES=10485760

# ------------------------------------------------------------------- solver
SOLVER_MAX_SECONDS=60
# SOLVER_WORKERS=8

# Pin for reproducible benchmarking only. Must stay unset in normal operation:
# semester persistence comes from stored assignments, never from a fixed seed.
# SOLVER_RANDOM_SEED=

# --------------------------------------------------------------- scheduling rules
# The department's confirmed rules. Change only if the department does.
# Every teacher gets a free period on any day they teach - that rule needs no
# setting. No teacher teaches more than this many periods in a row (a rule;
# 0 = no cap).
# FACULTY_MAX_CONSECUTIVE=6
# The run length the solver prefers not to exceed, weighted against the other
# preferences rather than enforced (0 = off).
# FACULTY_SOFT_MAX_CONSECUTIVE=4
# W_LONG_RUN=15
# The other preference weights: idle periods in a section's day, a teacher's
# busiest day, a subject twice in a day, a section spread across blocks.
# W_GAP=10
# W_SPREAD=3
# W_REPEAT=5
# W_PROXIMITY=1
# BYOD (charging points at the benches) applies to lectures as well as labs.
# ENFORCE_BYOD_ON_LECTURES=true

# --------------------------------------------------------------- demo data
# The demo dataset and its seed/reset endpoints. Always disabled when
# APP_ENV=production, regardless of this setting.
# ENABLE_DEMO_DATA=true

# --------------------------------------------------------------- ai assistant
# Google Gemini API key for the AI Timetable Assistant (optional).
# If unset, the backend uses its built-in deterministic schedule intelligence.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

